#!/bin/zsh
# barnowl: control Barn Owl from the Terminal. Barn Owl must be installed.
#
#   barnowl show | hide | toggle | all       hidden icons
#   barnowl bar | search | clipboard         panels
#   barnowl awake [minutes|+minutes|stop]    keep awake (no minutes = until stopped; +30 adds time)
#   barnowl present [on|off]                 presenter mode (no argument = toggle)
#   barnowl open <app>                       open an app's menu bar icon
#   barnowl place <app> visible|hidden|alwaysHidden
#   barnowl watch <app> [off]                show the icon when it changes
#   barnowl icon <app> <text>|reset          replace an app's icon with text or an emoji
#   barnowl settings [layout|general|menuBar|appearance|keepAwake|toggles|clipboard|shortcuts]
#   barnowl barn                             free up disk space
#   barnowl hoot                             say hello to the owl

set -e
encode() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"; }
go() { open -g "barnowl://$1"; }
script=$0
usage() { sed -n '2,15p' "$script" | sed 's/^# \{0,1\}//'; }

# The owl, in amber where the terminal has colour.
owl() {
  local a="" r=""
  if [[ -t 1 ]]; then a=$'\e[38;5;215m'; r=$'\e[0m'; fi
  print -r -- "${a}   ,___,${r}"
  print -r -- "${a}  ( O,O )${r}  $1"
  print -r -- "${a}  /)  _)${r}   $2"
  print -r -- "${a} --\"--\"--${r}"
}

if (( $# == 0 )); then
  owl "Barn Owl" "Wise about your menu bar. Wide awake when you need it."
  echo
  usage
  exit 0
fi

case "$1" in
  hoot)
    hoots=("Hoo!" "Hoo hoo!" "Hoot!" "Who? Me?" "Hello there!")
    owl "${hoots[$(( RANDOM % ${#hoots} + 1 ))]}" "" ;;
  show) go show ;;
  toggle) go toggle ;;
  hide) go hide ;;
  all) go show-all ;;
  bar) go bar ;;
  search) go search ;;
  clipboard) go clipboard ;;
  barn|disk) go barn ;;
  awake)
    case "${2:-}" in
      stop|off) go keep-awake/stop ;;
      +*) go "keep-awake/extend?minutes=${2#+}" ;;
      "") go "keep-awake?minutes=0" ;;
      *) go "keep-awake?minutes=$2" ;;
    esac ;;
  present|presenter)
    case "${2:-}" in
      on) go "presenter?on=1" ;;
      off) go "presenter?on=0" ;;
      *) go presenter ;;
    esac ;;
  open) go "open?app=$(encode "$2")" ;;
  place) go "place?app=$(encode "$2")&row=${3:-hidden}" ;;
  watch) go "watch?app=$(encode "$2")&on=$([[ "${3:-}" == off ]] && echo 0 || echo 1)" ;;
  icon)
    if [[ "${3:-}" == reset ]]; then go "icon?app=$(encode "$2")&reset=1"
    else go "icon?app=$(encode "$2")&label=$(encode "${3:-★}")"; fi ;;
  settings) go "settings${2:+?pane=$2}" ;;
  *) usage ;;
esac
